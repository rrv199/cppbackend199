  sprint_4:
    if: github.repository_owner != 'cpppracticum'
    runs-on: ubuntu-22.04
    steps:

      - name: Checkout code & tests
        uses: actions/checkout@v3
        with:
          submodules: true

      - name: Install dependencies
        run: |
          sudo apt update
          sudo apt install -y cmake libboost-all-dev

      - name: Build and test state_serialization
        run: |
          cd sprint4/problems/state_serialization/solution
          mkdir -p build && cd build
          cmake ..
          make -j4
          ./serialization_tests -s

      - name: Publish XML reports
        uses: EnricoMi/publish-unit-test-result-action@v2
        if: always()
        with:
          junit_files: ${{ github.workspace }}/*.xml
